# Copy to .env and adjust. .env is git-ignored; keep real values out of the repo.
PORT=3000
DATABASE_URL=postgres://localhost:5432/cleanm_dev
# Password of the two development admins created by `npm run db:seed`
# (ana@example.com and bruno@example.com). At least 8 characters.
SEED_ADMIN_PASSWORD=change-me-please
# Browser origins allowed to call the API with the session cookie, comma
# separated: the web client. Leave empty when there is none.
WEB_ORIGINS=http://localhost:5173
# Invoice PDFs are rendered by Chromium. Set to true on hosts that block its
# sandbox (Ubuntu 23.10+, most containers); leave unset elsewhere.
# CHROMIUM_NO_SANDBOX=true
